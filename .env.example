# Example local control-plane configuration. Never put a real secret in this file.
PATCHPROOF_WEBHOOK_SECRET=replace-with-a-random-local-secret
PATCHPROOF_ALLOWED_REPOSITORIES=owner/repository
PATCHPROOF_DATABASE_PATH=data/patchproof-control-plane.db

# Vertex AI uses Application Default Credentials; no service-account key file belongs here.
# PATCHPROOF_GEMINI_PROVIDER=VERTEX_AI
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# PATCHPROOF_GEMINI_MODEL=gemini-3.6-flash

# The Gemini Developer API remains explicitly configurable for local compatibility.
# PATCHPROOF_GEMINI_PROVIDER=GEMINI_DEVELOPER_API
# GEMINI_API_KEY=replace-with-a-local-api-key

# Opt in only to a deliberately authorized, potentially billable live smoke test.
# PATCHPROOF_RUN_LIVE_GEMINI=1
